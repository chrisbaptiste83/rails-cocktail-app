<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <meta name="description" content="">
    <meta name="author" content="">
    
    <title>Mike's Cantina</title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= 'home-page' if controller_name == 'home' && action_name == 'index' %>">

    <header class="sticky top-0 z-50 border-b border-white/10 bg-ink/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <span class="badge-glow"><i class="fas fa-cocktail"></i> Lounge</span>
          <%= link_to "Mike's Cantina", root_path, class: "text-xl font-display text-sand" %>
        </div>
        <nav class="flex flex-wrap items-center gap-2">
          <%= link_to root_path(anchor: "lounge"), class: "nav-link" do %>
            <i class="fas fa-door-open"></i> Lounge
          <% end %>
          <% unless user_signed_in? %>
            <%= link_to new_user_session_path, class: "nav-link" do %>
              <i class="fas fa-sign-in-alt"></i> Login
            <% end %>
            <%= link_to new_user_registration_path, class: "btn btn-outline-light" do %>
              <i class="fas fa-user-plus"></i> Sign Up
            <% end %>
          <% end %>
          <% if user_signed_in? %>
            <%= link_to cocktail_recipes_path, class: "nav-link" do %>
              <i class="fas fa-cocktail"></i> Cocktails
            <% end %>
            <%= link_to categories_path, class: "nav-link" do %>
              <i class="fas fa-list"></i> Categories
            <% end %>
            <%= link_to new_cocktail_recipe_path, class: "nav-link" do %>
              <i class="fas fa-plus-circle"></i> Create
            <% end %>
            <%= link_to ingredients_path, class: "nav-link" do %>
              <i class="fas fa-lemon"></i> Ingredients
            <% end %>
            <%= link_to current_user, class: "nav-link" do %>
              <i class="fas fa-user"></i> Profile
            <% end %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-outline-light" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% home_page = controller_name == 'home' && action_name == 'index' %>
    <div class="<%= home_page ? 'site-shell' : 'mx-auto max-w-6xl px-6 py-8' %>">
      <% if notice %>
        <div class="alert alert-info" role="alert">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-warning" role="alert">
          <%= alert %>
        </div>
      <% end %>
      <%= yield %>
    </div>

  </body>
</html>
