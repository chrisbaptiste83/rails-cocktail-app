<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <meta name="description" content="">
    <meta name="author" content="">
    
    <title>Mike's Cantina</title>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <nav class="navbar navbar-dark bg-dark navbar-expand-md sticky-top">
      <div class="container">
        <strong><%= link_to "Mike's Cantina", root_path, class: "navbar-brand" %></strong>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
          <ul class="navbar-nav ms-auto mb-2 mb-md-0">
            <% unless user_signed_in? %>
              <li class="nav-item">
                <%= link_to new_user_session_path, class: "nav-link" do %>
                  <i class="fas fa-sign-in-alt"></i> <strong>Login</strong>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to new_user_registration_path, class: "nav-link" do %>
                  <i class="fas fa-user-plus"></i> <strong>Sign Up</strong>
                <% end %>
              </li>
            <% end %>
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to cocktail_recipes_path, class: "nav-link" do %>
                  <i class="fas fa-cocktail"></i> Cocktails
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to categories_path, class: "nav-link" do %>
                  <i class="fas fa-list"></i> Categories
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to new_cocktail_recipe_path, class: "nav-link" do %>
                  <i class="fas fa-plus-circle"></i> Create a Cocktail
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to ingredients_path, class: "nav-link" do %>
                  <i class="fas fa-lemon"></i> Ingredients
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to current_user, class: "nav-link" do %>
                  <i class="fas fa-user"></i> Profile Page
                <% end %>
              </li>
            <% end %>
          </ul>
          <% if user_signed_in? %>
            <%= button_to('Logout', destroy_user_session_path, method: :delete, class: "btn btn-outline-light ms-2") %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if notice %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      <%= yield %>
    </div>

  </body>
</html>