<div class="glass-card space-y-6">
  <div>
    <h1 class="text-3xl">Categories</h1>
    <p class="text-sm text-sand/70">Browse the archive by category.</p>
  </div>

  <div class="space-y-3">
    <h3 class="text-xl font-display">Search for Category</h3>
    <%= form_tag(categories_path, method: "get", id: "search-form", class: "space-y-3") do %>
      <%= text_field_tag :search, params[:search], placeholder: "Search Categories", class: "form-control" %>
      <%= submit_tag "Search", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="divide-y divide-white/10">
    <% @categories.each do |category| %>
      <div class="py-4">
        <h2 class="text-2xl font-display"><%= link_to category.name, category_path(category) %></h2>
        <p class="text-sm text-sand/70"><%= pluralize(category.cocktail_recipes.count, "Cocktail") %></p>
      </div>
    <% end %>
  </div>
</div>
