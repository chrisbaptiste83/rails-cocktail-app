<div class="page-shell">
  <section class="page-hero">
    <div class="page-hero-content">
      <div>
        <div class="page-hero-kicker">Pantry Note</div>
        <h1 class="page-hero-title mt-3"><%= @ingredient.name %></h1>
        <p class="page-hero-lead mt-3"><%= pluralize(@ingredient.cocktail_recipes.count, "Cocktail Recipe") %> with this ingredient.</p>
      </div>
      <div class="page-actions">
        <%= link_to "Browse Ingredients", ingredients_path, class: "btn btn-ghost" %>
        <%= link_to "Explore Cocktails", cocktail_recipes_path, class: "btn btn-primary" %>
      </div>
    </div>
  </section>

  <section>
    <%= render partial: "cocktail_recipes/cocktails", locals: { cocktail_recipes: @ingredient.cocktail_recipes } %>
  </section>
</div>
