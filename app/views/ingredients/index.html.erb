<div class="glass-card space-y-6">
  <div>
    <h1 class="text-3xl">Ingredients</h1>
    <p class="text-sm text-sand/70">Explore cocktails by ingredient.</p>
  </div>

  <div class="space-y-3">
    <h3 class="text-xl font-display">Search for Ingredients</h3>
    <%= form_tag(ingredients_path, method: "get", id: "search-form", class: "space-y-3") do %>
      <%= text_field_tag :search, params[:search], placeholder: "Search Ingredients", class: "form-control" %>
      <%= submit_tag "Search", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="divide-y divide-white/10">
    <% @ingredients.each do |ingredient| %>
      <div class="py-4">
        <h2 class="text-2xl font-display"><%= link_to ingredient.name, ingredient_path(ingredient) %></h2>
        <p class="text-sm text-sand/70"><%= pluralize(ingredient.cocktail_recipes.count, "Cocktail") %></p>
      </div>
    <% end %>
  </div>
</div>
