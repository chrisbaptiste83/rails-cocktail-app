<div class="page-shell">
  <section class="page-hero">
    <div class="page-hero-content">
      <div>
        <div class="page-hero-kicker">House Pour</div>
        <h1 class="page-hero-title mt-3"><%= @cocktail_recipe.title %></h1>
        <p class="page-hero-lead mt-3"><%= @cocktail_recipe.description %></p>
        <div class="recipe-meta mt-4">
          <span class="recipe-badge"><i class="fas fa-tag"></i> <%= link_to @cocktail_recipe.category.name, category_path(@cocktail_recipe.category) %></span>
          <span class="recipe-badge"><i class="fas fa-user"></i> <%= link_to @cocktail_recipe.user.username, user_path(@cocktail_recipe.user) %></span>
          <span><%= last_updated @cocktail_recipe %></span>
        </div>
      </div>
      <% if @cocktail_recipe.user == current_user %>
        <div class="page-actions">
          <%= link_to "Edit This Recipe", edit_cocktail_recipe_path, class: "btn btn-primary" %>
          <%= button_to "Delete", cocktail_recipe_path(@cocktail_recipe), method: :delete, class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="detail-grid">
    <div class="detail-panel">
      <%= image_tag(@cocktail_recipe.avatar.variant(resize_to_limit: [640, 480]), class: "w-full rounded-2xl") if @cocktail_recipe.avatar.attached? %>
      <div class="mt-6">
        <h3 class="text-2xl"><i class="fas fa-mortar-pestle text-emberGlow/70 mr-2"></i>Ingredients</h3>
        <ul class="mt-4 space-y-0 text-sm text-sand/80">
          <% @cocktail_recipe.recipe_ingredients.each_with_index do |i, idx| %>
            <li class="flex items-center justify-between border-b border-white/10 px-3 py-3 <%= idx.even? ? 'bg-white/[0.03]' : '' %> rounded">
              <span><%= i.quantity %></span>
              <span><%= link_to i.ingredient.name, ingredient_path(i.ingredient) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <div class="detail-panel smoke space-y-6 text-sm text-sand/90">
      <div>
        <h4 class="text-lg text-sand"><i class="fas fa-list-ol text-emberGlow/70 mr-2"></i>Directions</h4>
        <p class="mt-2"><%= @cocktail_recipe.directions %></p>
      </div>
      <div class="cantina-divider"></div>
      <div>
        <h4 class="text-lg text-sand"><i class="fas fa-tag text-emberGlow/70 mr-2"></i>Category</h4>
        <p class="mt-2"><%= link_to @cocktail_recipe.category.name, category_path(@cocktail_recipe.category) %></p>
      </div>
      <div class="cantina-divider"></div>
      <div>
        <h4 class="text-lg text-sand"><i class="fas fa-user text-emberGlow/70 mr-2"></i>Originally Crafted</h4>
        <p class="mt-2">By <%= link_to @cocktail_recipe.user.username, user_path(@cocktail_recipe.user) %></p>
      </div>
    </div>
  </section>

  <section class="detail-panel">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h4 class="text-xl"><i class="fas fa-comments text-emberGlow/70 mr-2"></i><%= @cocktail_recipe.comments.count %> Comment(s)</h4>
      <span class="recipe-badge"><i class="fas fa-comments"></i> Lounge Notes</span>
    </div>
    <div class="cantina-divider"></div>
    <div class="space-y-4">
      <% @cocktail_recipe.comments.each do |comment| %>
        <div class="comment-card">
          <p><%= comment.content %></p>
          <small class="text-sand/80">By: <%= comment.user.username %> · <%= created_at comment %></small>
        </div>
      <% end %>
      <div class="space-y-2">
        <h5 class="text-lg">Add a comment</h5>
        <%= render partial: "comments/form" %>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap gap-3">
    <%= link_to "Next Cocktail", @cocktail_recipe.next, class: "btn btn-primary" %>
    <%= link_to "Previous Cocktail", @cocktail_recipe.previous, class: "btn btn-ghost" %>
  </div>
</div>
