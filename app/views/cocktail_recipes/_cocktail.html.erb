<article class="recipe-card">
  <% if cocktail_recipe.avatar.attached? %>
    <div class="recipe-card-img">
      <%= ik_image_tag cocktail_recipe.avatar, transformation: [{ width: 420, height: 320, crop: "at_max" }], class: "w-full rounded-t-3xl" %>
    </div>
  <% end %>
  <div class="recipe-card-body">
    <div class="recipe-meta">
      <span class="recipe-badge"><i class="fas fa-tag"></i> <%= link_to cocktail_recipe.category.name, category_path(cocktail_recipe.category) %></span>
      <span><%= created_at cocktail_recipe %></span>
    </div>
    <h2 class="text-2xl font-display"><%= link_to cocktail_recipe.title, cocktail_recipe_path(cocktail_recipe) %></h2>
    <p class="text-sm text-sand/80 line-clamp-2"><%= cocktail_recipe.description %></p>
    <div class="flex flex-wrap items-center gap-3 text-sm text-sand/85">
      <span class="flex items-center gap-1">
        <i class="fas fa-user"></i>
        <%= link_to cocktail_recipe.user.username, user_path(cocktail_recipe.user) %>
      </span>
      <span class="badge badge-sm badge-outline gap-1 text-sand/80">
        <i class="fas fa-mortar-pestle"></i> <%= cocktail_recipe.recipe_ingredients.size %>
      </span>
      <span class="badge badge-sm badge-outline gap-1 text-sand/80">
        <i class="fas fa-comments"></i> <%= cocktail_recipe.comments.size %>
      </span>
    </div>
  </div>
</article>
