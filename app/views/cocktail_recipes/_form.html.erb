<%= form_for(@cocktail_recipe, html: { class: "space-y-6" }) do |f| %>
  <div class="space-y-2">
    <h3 class="text-xl"><%= f.label :title %></h3>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="space-y-2">
    <h3 class="text-xl"><%= f.label :category %></h3>
    <%= f.text_field :category_name, list: "categories_autocomplete", class: "form-control" %>
    <datalist id="categories_autocomplete">
      <% Category.all.each do |category| %>
        <option value="<%= category.name %>">
      <% end %>
    </datalist>
  </div>

  <div class="space-y-2">
    <h3 class="text-xl"><%= f.label :description %></h3>
    <%= f.text_area :description, class: "form-control" %>
  </div>

  <%= f.hidden_field :user_id %>

  <div class="space-y-3">
    <h3 class="text-xl"><%= f.label :ingredients %></h3>

    <div class="space-y-4">
      <%= f.fields_for :recipe_ingredients, @ingredients do |recipe_ingredient| %>
        <div class="rounded-2xl border border-white/10 bg-ink/60 p-4">
          <div class="grid gap-3 md:grid-cols-3">
            <div class="space-y-2">
              <label class="text-sm text-sand/70">Quantity</label>
              <%= recipe_ingredient.text_field :quantity, class: "form-control" %>
            </div>
            <div class="space-y-2">
              <label class="text-sm text-sand/70">Select Ingredient</label>
              <%= recipe_ingredient.collection_select :ingredient_id, Ingredient.all.order(:name), :id, :name, { include_blank: "Select Ingredient" }, class: "form-control" %>
            </div>
            <div class="space-y-2">
              <label class="text-sm text-sand/70">Or Create New</label>
              <%= recipe_ingredient.fields_for :ingredient, @cocktail_recipe.ingredients.build do |ingredient| %>
                <%= ingredient.text_field :name, class: "form-control" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="space-y-2">
    <h3 class="text-xl"><%= f.label :directions %></h3>
    <%= f.text_area :directions, class: "form-control" %>
  </div>

  <div class="space-y-2">
    <h4 class="text-lg">Upload an Image</h4>
    <%= f.file_field :avatar, class: "form-control" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>

  
