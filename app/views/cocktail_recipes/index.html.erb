<div class="page-shell">
  <section class="page-hero">
    <div class="page-hero-content">
      <div>
        <div class="page-hero-kicker">Lounge Archive</div>
        <h1 class="page-hero-title mt-3">Cocktails</h1>
        <p class="page-hero-lead mt-3">Search the lounge archive by title or filter by bartender to find the perfect pour.</p>
        <div class="recipe-meta mt-4">
          <span class="recipe-badge"><i class="fas fa-wine-glass-alt"></i> <%= @cocktail_recipe_total %> pours</span>
        </div>
      </div>
      <div class="page-actions">
        <%= link_to "Create a Recipe", new_cocktail_recipe_path, class: "btn btn-primary" %>
        <%= link_to "Browse Categories", categories_path, class: "btn btn-ghost" %>
      </div>
    </div>
  </section>

  <section class="detail-grid">
    <div class="panel-card">
      <h3 class="text-xl font-display">Search by Title</h3>
      <%= form_tag(cocktail_recipes_path, method: "get", id: "search-form", class: "mt-4 space-y-3") do %>
        <%= text_field_tag :search, params[:search], placeholder: "Search Cocktails", class: "input input-bordered w-full" %>
        <%= submit_tag "Search", class: "btn btn-primary w-full" %>
      <% end %>
    </div>
    <div class="panel-card smoke">
      <h3 class="text-xl font-display">Filter by Bartender</h3>
      <%= form_tag("/cocktail_recipes", method: "get", class: "mt-4 space-y-3") do %>
        <%= select_tag "user", options_from_collection_for_select(@bartenders, "id", "username", params[:user]), include_blank: "Choose a bartender", class: "select select-bordered w-full" %>
        <%= submit_tag "Filter", class: "btn btn-ghost w-full" %>
      <% end %>
    </div>
  </section>

  <section>
    <%= render partial: "cocktails", locals: {cocktail_recipes: @cocktail_recipes} %>
    <% if @previous_page || @next_page %>
      <div class="page-actions mt-8">
        <% if @previous_page %>
          <%= link_to "Previous", cocktail_recipes_path(request.query_parameters.merge(page: @previous_page)), class: "btn btn-ghost" %>
        <% end %>
        <% if @next_page %>
          <%= link_to "Next", cocktail_recipes_path(request.query_parameters.merge(page: @next_page)), class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
